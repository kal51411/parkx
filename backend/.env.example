DATABASE_URL=postgresql+psycopg://parkx:password@localhost:5432/parkx
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Payment - use "mock" for development, "razorpay" for production
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps
MAPBOX_TOKEN=

# AI Assistant (Google Gemini)
GEMINI_API_KEY=

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Business rules
NO_SHOW_GRACE_PERIOD_MINUTES=30
BOOKING_HOLD_MINUTES=8
MAX_BOOKING_HOURS=24
